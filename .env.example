# DB（アプリ必須）
# ローカル Docker Compose 例: postgresql://shop:shop@localhost:5432/shop
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=

# Auth（認証を使う場合）
# 生成例: openssl rand -base64 32
AUTH_SECRET=

# メール Resend（送信を使う場合）
RESEND_API_KEY=
EMAIL_FROM=

# 公開 URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# OAuth（使う場合のみ）
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
